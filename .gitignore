# Raw game rips: regenerate with tools/collect_assets.py, never commit
extracted/

# Ripped meshes/textures/materials are regenerated from your own BO2 install by
# tools/export_unity.py + "Origins Staffs/Rebuild Ripped Prefabs". Keep their .meta files
# so prefab references (GUIDs) survive a fresh clone.
Unity/Assets/OriginsStaffs/Ripped/**
!Unity/Assets/OriginsStaffs/Ripped/**/
!Unity/Assets/OriginsStaffs/Ripped/**/*.meta

# Generated by "Origins Staffs/Build Staffs" (and "Rebuild Ripped Prefabs") from the ripped
# assets: the prefabs carry BO2-derived data (skeletons, reload animation keys) and the build
# profile a local r2modman path. Rebuild them instead of committing them.
# (Their folder .meta files are ignored in Unity/.gitignore, which re-includes every .meta under Assets.)
Unity/Assets/OriginsStaffs/Prefabs/
Unity/Assets/OriginsStaffs/Data/

# Activision's promo image the spawner folder thumbnail was cut from (the thumbnail is in Art/)
art/elemental_staffs_source.jpg

# Copies of the repo-root docs made by PackageDocsSync
Unity/Assets/OriginsStaffs/Package/*
!Unity/Assets/OriginsStaffs/Package/*.meta

# MeatKit/Unity build output
Unity/AssetBundles/
build/
package/*
!package/.gitkeep

# Python bytecode from running tools/
__pycache__/
